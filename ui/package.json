{
  "name": "agent-director-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "design:lint": "node ./scripts/design_lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:review": "playwright test --config playwright.review.config.ts",
    "test:e2e:visual-matrix": "playwright test --config playwright.visual.config.ts",
    "api:generate": "python3 ../scripts/generate_openapi_client.py",
    "scan:check": "node ./scripts/scan_check.mjs",
    "lhci": "bash ./scripts/lhci.sh",
    "percy:playwright": "percy exec -- playwright test tests/e2e/visual.spec.ts tests/e2e/ux-review.spec.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/unbounded": "^5.2.8",
    "framer-motion": "^11.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@percy/cli": "^1.31.13",
    "@percy/playwright": "^1.0.7",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.11.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.6"
  }
}
